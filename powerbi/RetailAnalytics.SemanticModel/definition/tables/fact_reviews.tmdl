/// One row per (review_id, order_id). Free-text comments are not exported. Use is_latest_review_for_order for one review per order.
table fact_reviews
	lineageTag: f8bab684-8962-5a93-8354-5ae67e4bd57a

	/// Average of the latest review per delivered order. Use with fact_orders[delay_bucket].
	measure 'Average Review Score' = CALCULATE(AVERAGE(fact_reviews[review_score]), fact_reviews[is_latest_review_for_order] = TRUE(), fact_orders[delay_bucket_order] >= 1)
		formatString: 0.00
		displayFolder: Reviews
		lineageTag: dc5f2284-3c86-5f08-8ef6-48be4b2395a6

	/// Delivered orders with a latest review.
	measure 'Reviewed Orders' = CALCULATE(COUNTROWS(fact_reviews), fact_reviews[is_latest_review_for_order] = TRUE(), fact_orders[delay_bucket_order] >= 1)
		formatString: #,0
		displayFolder: Reviews
		lineageTag: 09407769-3700-5622-8ae5-e995aedacbd6

	/// Share of reviews with 1 or 2 stars.
	measure 'Low Score %' = DIVIDE(CALCULATE(COUNTROWS(fact_reviews), fact_reviews[is_latest_review_for_order] = TRUE(), fact_orders[delay_bucket_order] >= 1, fact_reviews[review_score] <= 2), [Reviewed Orders])
		formatString: 0.0%
		displayFolder: Reviews
		lineageTag: 2f855b2c-af9e-5d24-a5e3-c56d1f74a68a

	column review_id
		dataType: string
		lineageTag: 811685f5-6c35-58e8-852a-b5c52d765e62
		summarizeBy: none
		sourceColumn: review_id

	column order_id
		dataType: string
		lineageTag: 5cd2b820-7e31-52a7-b0a6-6ef3da5cf500
		summarizeBy: none
		sourceColumn: order_id

	column customer_key
		dataType: int64
		isHidden
		lineageTag: 30d742d4-a475-5237-bf13-8ced76fa551b
		summarizeBy: none
		sourceColumn: customer_key

	column review_creation_date_key
		dataType: int64
		isHidden
		lineageTag: ed77e2fe-2d1f-53ed-b379-8e169784fa5d
		summarizeBy: none
		sourceColumn: review_creation_date_key

	column review_answer_date_key
		dataType: int64
		isHidden
		lineageTag: 1303a744-c832-52fa-b635-f19b2e3fb668
		summarizeBy: none
		sourceColumn: review_answer_date_key

	column review_creation_ts
		dataType: dateTime
		lineageTag: 5786f868-e4de-572c-a753-825070167592
		summarizeBy: none
		sourceColumn: review_creation_ts

	column review_answer_ts
		dataType: dateTime
		lineageTag: 9ab6e304-4706-5427-84e4-64b3bdfe1347
		summarizeBy: none
		sourceColumn: review_answer_ts

	column review_score
		dataType: int64
		lineageTag: d1799ed3-6275-5ceb-9ff7-8eec75817e08
		summarizeBy: none
		sourceColumn: review_score

	column has_comment
		dataType: boolean
		lineageTag: 2024adca-ec9f-55ee-9166-45fdf3cf2238
		summarizeBy: none
		sourceColumn: has_comment

	column is_latest_review_for_order
		dataType: boolean
		lineageTag: 1f2d0164-e989-5087-9a2b-83e668c651b3
		summarizeBy: none
		sourceColumn: is_latest_review_for_order

	partition fact_reviews = m
		mode: import
		source =
			let
				Source = Parquet.Document(File.Contents(DataFolder & "\fact_reviews.parquet")),
				Typed = Table.TransformColumnTypes(Source, {{"review_id", type text}, {"order_id", type text}, {"customer_key", Int64.Type}, {"review_creation_date_key", Int64.Type}, {"review_answer_date_key", Int64.Type}, {"review_creation_ts", type datetime}, {"review_answer_ts", type datetime}, {"review_score", Int64.Type}, {"has_comment", type logical}, {"is_latest_review_for_order", type logical}})
			in
				Typed
