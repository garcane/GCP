/// One row per order, including orders with no items. Items and payments are pre-aggregated to this grain. Derived flags: is_net_order, is_labelled_delivery; derived columns: promised_days, delay_bucket.
table fact_orders
	lineageTag: 604da6ba-e892-5f3b-bd02-e0358f7ad615

	/// Delivered orders with a late/on-time label and no timestamp anomaly (the population used for the model).
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(fact_orders), fact_orders[is_labelled_delivery] = TRUE())
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 4f5d40c0-97f3-547c-bc2b-92fa4bca8426

	/// Delivered after the estimated date.
	measure 'Late Orders' = CALCULATE(COUNTROWS(fact_orders), fact_orders[is_labelled_delivery] = TRUE(), fact_orders[is_late] = TRUE())
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 0497405d-5478-5893-8070-91daf660e0fb

	/// Share of delivered orders that arrived late.
	measure 'Late Rate %' = DIVIDE([Late Orders], [Delivered Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 08c4f895-775e-57e6-9076-7b70e28bc1d6

	/// Median days from purchase to delivery.
	measure 'Median Delivery Days' = CALCULATE(MEDIAN(fact_orders[delivery_days]), fact_orders[is_labelled_delivery] = TRUE())
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 8d64d1e2-b4fa-5f90-9244-39290fe3ffe0

	/// Average delivery window promised at checkout.
	measure 'Average Promised Days' = CALCULATE(AVERAGE(fact_orders[promised_days]), fact_orders[is_labelled_delivery] = TRUE())
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 40332975-b850-532d-8595-722f1f52d047

	/// Share of delivered orders promised in under 20 days (it jumped in 2018).
	measure 'Share Promised Under 20 Days' = DIVIDE(CALCULATE(COUNTROWS(fact_orders), fact_orders[is_labelled_delivery] = TRUE(), fact_orders[promised_days] < 20), [Delivered Orders])
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 3f58c440-7f38-5033-bd10-59405cd6e80c

	/// Example of the inactive relationship: orders counted by the day they were delivered, not purchased.
	measure 'Orders by Delivery Date' = CALCULATE(COUNTROWS(fact_orders), USERELATIONSHIP(fact_orders[delivered_customer_date_key], dim_date[date_key]))
		formatString: #,0
		displayFolder: Delivery
		lineageTag: da86907e-103c-5d67-8187-07c2e2223f3c

	/// Net orders counted on the order grain (used for repeat-customer measures).
	measure 'Net Orders (orders table)' = CALCULATE(COUNTROWS(fact_orders), fact_orders[is_net_order] = TRUE())
		formatString: #,0
		displayFolder: Customers
		lineageTag: 793ac53c-bc7d-5b75-9d76-80039ba1eba6

	/// Real customers with at least one net order.
	measure 'Customers Ordering' = COUNTROWS(FILTER(VALUES(dim_customer[customer_key]), [Net Orders (orders table)] >= 1))
		formatString: #,0
		displayFolder: Customers
		lineageTag: 3c9e5ce5-75fd-5f02-98bc-d10c07eef022

	/// Share of customers who ordered exactly once (about 97%).
	measure 'One-Time Customer Share' = DIVIDE(COUNTROWS(FILTER(VALUES(dim_customer[customer_key]), [Net Orders (orders table)] = 1)), [Customers Ordering])
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 9f454586-f4ce-5aec-b0e3-8774804bd267

