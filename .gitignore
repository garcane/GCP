# Local DuckDB warehouse is rebuilt from data/ + sql/ by src/transformation/build_warehouse.py
*.duckdb
*.duckdb.wal

# Raw Olist dataset (Kaggle, CC BY-NC-SA 4.0): re-downloadable, not stored in Git
data/

# Secrets and credentials (none are expected in this local-only project)
.env
.env.*
*.pem
*.key
*service-account*.json
*credentials*.json

__pycache__/
.ipynb_checkpoints/

# graphify: keep the graph and report, not its cache or dated backups (regenerated by `graphify update .`)
graphify-out/cache/
graphify-out/20*/

# Power BI: exported data is regenerable (src/powerbi/export_data.py); local Power BI state is per-user
powerbi/data/
**/.pbi/

# marimo session caches (cell outputs, regenerated on every run)
__marimo__/
